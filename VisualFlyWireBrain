# --------------------------- Plotly 3D Visualization ---------------------------
import plotly.graph_objects as go
import numpy as np

print("\nPreparing 3D scatter data for Plotly...")

# Convert coordinate dictionary to arrays
ids = list(scaled_coords_dict.keys())
coords = np.array(list(scaled_coords_dict.values()))

x, y, z = coords[:, 0], coords[:, 1], coords[:, 2]

# Create node scatter trace (neurons)
node_trace = go.Scatter3d(
    x=x,
    y=y,
    z=z,
    mode="markers",
    marker=dict(
        size=2,
        color="cyan",
        opacity=0.8
    ),
    text=[f"Neuron {nid}" for nid in ids],
    hoverinfo="text"
)

# Optional: include edges (⚠️ slow if you have >10k)
max_edges_to_plot = 5000  # adjust lower if laggy
print(f"Adding up to {max_edges_to_plot:,} edges to 3D plot...")

edge_x, edge_y, edge_z = [], [], []
for i, (u, v, data) in enumerate(G.edges(data=True)):
    if i >= max_edges_to_plot:
        break
    if u in scaled_coords_dict and v in scaled_coords_dict:
        x0, y0, z0 = scaled_coords_dict[u]
        x1, y1, z1 = scaled_coords_dict[v]
        edge_x += [x0, x1, None]
        edge_y += [y0, y1, None]
        edge_z += [z0, z1, None]

edge_trace = go.Scatter3d(
    x=edge_x,
    y=edge_y,
    z=edge_z,
    mode="lines",
    line=dict(color="rgba(150,150,150,0.2)", width=1),
    hoverinfo="none"
)

# --------------------------- Build Figure ---------------------------
fig = go.Figure(data=[edge_trace, node_trace])
fig.update_layout(
    title="FlyWire 3D Neuron Connectivity (Plotly)",
    showlegend=False,
    scene=dict(
        xaxis=dict(visible=False),
        yaxis=dict(visible=False),
        zaxis=dict(visible=False),
        aspectmode="data",
        bgcolor="black"
    ),
    paper_bgcolor="black",
    margin=dict(l=0, r=0, b=0, t=40)
)

# Save interactive HTML (GPU accelerated)
output_path = "FlywireGraph_Plotly3D.html"
fig.write_html(output_path)
print(f"✅ Saved 3D Plotly graph to {output_path}")
print("👉 Open it in Edge or Chrome — it supports panning, zooming, and hovering without crashing!")
